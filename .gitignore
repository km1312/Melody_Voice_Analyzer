# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# PyInstaller output
build/
dist/

# Editors
.idea/
.vscode/

# Run logs and transcript output.
#
# These hold real conversations: participant names, contact details and the
# verbatim content of private calls. The people recorded did not agree to being
# published, so nothing derived from a real recording is committed here.
*.log
*.log.old
transcript_output.json
*.analysis.json
*.srt
*.csv

# Archived snapshots of this folder
*.zip

# The first-run HuggingFace token build.ps1 seeds into the bundle
revolv/assets/hf_token.txt

# Interpretation layer: derived files are as sensitive as the recording
*.context.json
*.context.json.bak
*.insights.json
*.notes.md
*.prompt/
*.clips/
melody.db
tests/_scratch/

# The synthetic test fixture carries no real speech and is committed on
# purpose; these negations lift the blanket patterns above for it.
!tests/fixtures/**/*.analysis.json
!tests/fixtures/**/*.insights.json
!tests/fixtures/**/*.notes.md
!tests/fixtures/**/*.context.json

# Media
*.wav
*.mp3
*.m4a
*.flac
*.ogg
*.opus
*.mp4
*.mkv
*.mov
*.webm
